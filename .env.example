# Credenciais do banco — MODELO. Copie para .env e troque todas as senhas:
#
#   cp .env.example .env
#
# O .env está no .gitignore. É o único lugar do projeto com senha em texto:
# nem o compose.yaml nem os .sql têm senha escrita.
#
# Gerar uma senha forte: openssl rand -base64 24

# Superusuário do Postgres. Usado só na criação do container.
SGV_SENHA_POSTGRES=troque-esta-senha

# Migrações e deploy (grupo sgv_ddl).
SGV_SENHA_MIGRATOR=troque-esta-senha

# Runtime da sgv-api (grupo sgv_app).
SGV_SENHA_API=troque-esta-senha

# Acesso do time via psql/DBeaver (grupo sgv_leitura).
SGV_SENHA_DEV=troque-esta-senha
